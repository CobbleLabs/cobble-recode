class net/minecraft/util/EntitySelectors                            cobble/v1_7/compat/EntitySelectors
class net/minecraft/network/EnumPacketDirection                     cobble/v1_7/compat/EnumPacketDirection
class net/minecraft/network/play/client/C07PacketPlayerDigging$Action cobble/v1_7/compat/DiggingAction
class net/minecraft/network/ThreadQuickExitException                cobble/v1_7/compat/ThreadQuickExitException
class net/minecraft/entity/player/EnumPlayerModelParts              cobble/v1_7/compat/EnumPlayerModelParts
class net/minecraft/entity/item/EntityArmorStand                    cobble/v1_7/compat/EntityArmorStand
class net/minecraft/network/play/server/S45PacketTitle              cobble/v1_7/compat/Absent
