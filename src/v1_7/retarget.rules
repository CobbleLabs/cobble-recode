class net/minecraft/client/renderer/BlockRendererDispatcher         cobble/v1_7/compat/BlockRendererDispatcher
class net/minecraft/client/renderer/BlockModelShapes                cobble/v1_7/compat/BlockModelShapes
class net/minecraft/network/play/server/S22PacketMultiBlockChange$BlockUpdateData cobble/v1_7/compat/BlockUpdateData
# 1.7.10 spells it with an extra r.
class net/minecraft/client/renderer/culling/Frustum                 net/minecraft/client/renderer/culling/Frustrum
class net/minecraft/client/model/ModelPlayer                        net/minecraft/client/model/ModelBiped

