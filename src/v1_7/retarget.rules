# 1.8.9 references and what they are on 1.7.10, for the legacy code; see
# tools/Retarget.java for the rule forms. Plain renames come out of MCP's
# Searge tables for both versions and are not listed. Members are named by the
# 1.8.9 class that declares them; right-hand sides are in 1.7.10's MCP names,
# and every type is spelled out.

# ---------------------------------------------------------------- shims ----
# Entity's Y and what is measured from it, the 1.8.9 way; see EntityShim.
shims cobble/v1_7/compat/
class net/minecraft/util/BlockPos                                   cobble/v1_7/compat/BlockPos
class net/minecraft/util/BlockPos$MutableBlockPos                   cobble/v1_7/compat/BlockPos$MutableBlockPos
