#include <winver.h>

#define COLD_ASSET_BLOB_ID 4001

COLD_ASSET_BLOB_ID RCDATA "@COLD_ASSET_BLOB@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1, 0, 0, 0
 PRODUCTVERSION 1, 0, 0, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "cobble.vip"
            VALUE "FileDescription", "Cobble Recode payload (@COLD_FLAVOUR_LABEL@)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "cobble"
            VALUE "OriginalFilename", "cobble.dll"
            VALUE "ProductName", "Cobble Recode"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "BuildFlavour", "@COLD_FLAVOUR_LABEL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
